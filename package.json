{
  "name": "@michengai/dsh-simplify",
  "version": "0.1.0",
  "description": "DSH 代码简化插件：限定变更范围，支持 Windows、未跟踪文件及可靠的 Git 失败处理",
  "repository": { "type": "git", "url": "git+https://github.com/MichengAI/dsh-simplify.git" },
  "homepage": "https://github.com/MichengAI/dsh-simplify#readme",
  "bugs": { "url": "https://github.com/MichengAI/dsh-simplify/issues" },
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.19.0" },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" } },
  "files": ["lib", "assets/branding/dsh-simplify-banner.png", "cordis.patch.yml", "README.md", "README.zh-CN.md", "LICENSE", "CHANGELOG.md", "CHANGELOG.zh-CN.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.2-rc.1",
    "@types/node": "^22.19.0",
    "typescript": "~5.7.2"
  }
}
